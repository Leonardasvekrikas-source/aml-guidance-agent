# Copy to .env and fill in. .env is gitignored.

# Required for drafting and the LLM judge (M2, M3, M4).
# Retrieval and the M1 benchmark run without it.
ANTHROPIC_API_KEY=

# Only needed for identity-linked API keys, which must name the workspace a
# request acts in. Find it in the Anthropic Console under Settings ->
# Workspaces; it looks like wrkspc_01ABC...
ANTHROPIC_WORKSPACE_ID=

# Model used for drafting and judging.
ANTHROPIC_MODEL=claude-opus-5

# Postgres. These defaults match docker-compose.yml.
POSTGRES_USER=aml
POSTGRES_PASSWORD=aml
POSTGRES_DB=aml
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Host port Postgres is published on. Change if 5434 is taken on your machine;
# it does not affect how the app reaches the database inside the network.
POSTGRES_HOST_PORT=5434

# Embedding model. 768 dimensions — must match vector(768) in the migration.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# Set to cpu if you have no CUDA GPU. Ingestion is slower but works.
EMBEDDING_DEVICE=cuda
