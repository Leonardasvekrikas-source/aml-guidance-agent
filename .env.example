# Copy to .env and fill in. .env is gitignored.

# Required for drafting and the LLM judge (M2, M3, M4).
# Retrieval and the M1 benchmark run without it.
ANTHROPIC_API_KEY=

# Only needed for identity-linked API keys, which must name the workspace a
# request acts in. Find it in the Anthropic Console under Settings ->
# Workspaces; it looks like wrkspc_01ABC...
ANTHROPIC_WORKSPACE_ID=

# Model used for drafting and judging.
ANTHROPIC_MODEL=claude-opus-5

# Postgres. These defaults match docker-compose.yml.
POSTGRES_USER=aml
POSTGRES_PASSWORD=aml
POSTGRES_DB=aml
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Host port Postgres is published on. Change if 5434 is taken on your machine;
# it does not affect how the app reaches the database inside the network.
POSTGRES_HOST_PORT=5434

# Which embedding model to use. Defined in src/aml_agent/config.py:
#   bge-m3    BAAI/bge-m3, 1024d          (default)
#   bge-base  BAAI/bge-base-en-v1.5, 768d (the baseline in the ablation)
#   e5-large  intfloat/multilingual-e5-large-instruct, 1024d
# The vector column and query/passage prefixes follow from this choice, so it
# is the only embedding setting you should need to change.
EMBEDDING_MODEL_KEY=bge-m3

# Cross-encoder reranker, and how many first-stage candidates it scores.
# 50 is measured, not guessed: results/candidate_sweep.json shows the ceiling
# saturating there.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=50

# Set to cpu if you have no CUDA GPU. Ingestion is slower but works.
EMBEDDING_DEVICE=cuda
